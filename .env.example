# Server
MADE_PORT=3100
MADE_HOST=127.0.0.1
# MADE_TOKEN=changeme    # Auth token. Leave unset for dev (no auth).
MADE_CORS_ORIGIN=         # CORS origin. Default: same-origin only.
MADE_DATA_DIR=.made-data  # Where sessions/messages are stored.

# Agent (optional overrides)
# MADE_AGENT_CMD=auto     # Force a specific agent: hermes|opencode|claude|codex

# Sandbox
# MADE_SANDBOX=false      # Block dangerous commands (rm -rf, sudo, etc.)
